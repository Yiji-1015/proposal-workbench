{
  "name": "proposal_blue_system",
  "version": "1.0",
  "intent": "고밀도 제안서 도식용 공통 색상·밀도 토큰",
  "colors": {
    "navy": "#0B1F4D",
    "primary": "#1769E0",
    "primary_dark": "#123B78",
    "primary_light": "#EAF2FF",
    "secondary": "#5BA7E8",
    "secondary_dark": "#2F82C4",
    "surface": "#F3F6FA",
    "surface_blue": "#EEF5FF",
    "text": "#12213A",
    "muted_text": "#5B6B82",
    "line": "#B6C4D8",
    "success": "#2F6F95",
    "warning": "#6B7280",
    "danger": "#374151",
    "white": "#FFFFFF"
  },
  "usage": {
    "default_accent": "primary",
    "default_title": "navy",
    "default_body": "text",
    "default_panel": "surface",
    "default_flow": "primary",
    "semantic_accents_only": true,
    "semantic_accent_rule": "가능하면 블루·회색으로 표현하고, 외부 요구로 상태색이 필요한 경우에만 success/warning/danger 토큰을 사용"
  },
  "density": {
    "mode": "high",
    "canvas": "16:9",
    "outer_margin_px": 48,
    "header_height_px": 104,
    "content_columns": "2-5",
    "minimum_body_font_px": 13,
    "preferred_body_font_px": 15,
    "preferred_title_font_px": 28,
    "max_primary_message_lines": 2,
    "max_card_body_lines": 5,
    "rule": "빈 공간보다 정보 구조와 반복 가능한 모듈을 우선하되, 카드 간 간격은 유지"
  }
}
